# Plantilla de variables de entorno para Operacion Babel (PostgreSQL).
# Copia este archivo como .env y completa con tus credenciales locales.
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgresql
DB_HOST=localhost
DB_DATABASE=operacionbabel
DB_PORT=5432
PORT=3000

# Opcional: clave de la Oficina de Operaciones (si no se define,
# src/config/security.js usa su valor por defecto).
# ADMIN_SECURITY_KEY=cambia_esta_clave
